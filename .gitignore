# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
build/
dist/

# Virtual environments
.venv/
venv/

# Datasets and checkpoints (large, downloaded)
data/

# Run outputs (keep per-run record/manifest, drop bulky artifacts)
runs/*/preds/
runs/*/scenarios/
runs/*/*.log
runs/*/log.txt

# Model weights / large binaries
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.zip

# Vendored upstream checkout with its own git history
third_party/OpenCOOD/

# Editors / secrets
.idea/
.vscode/
.env

# E0 caches (large)
runs/*/cache/

# E4 dev caches (large)
runs/*/*/cache/

# nested caches (E5 dry run)
runs/**/cache/

# audit smoke-test caches (large)
runs/20261024-AUDIT/*_cache.pkl.gz
runs/**/extra/
runs/**/pgd/
runs/**/v3extra/
